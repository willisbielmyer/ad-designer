# Browser-safe Supabase values
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_IDEA_AGENT_EMAIL=

# Server-only Supabase service role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
IDEA_AGENT_EMAIL=

# Research provider (Haiku is the cheapest option)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5

# Telegram bot token from @BotFather (free)
TELEGRAM_BOT_TOKEN=

# How often ideas are sent, in hours (1-24). Higher = cheaper.
IDEA_INTERVAL_HOURS=6

# Random secret used to authenticate the scheduled endpoint
CRON_SECRET=

# Public URL of this standalone app, shown in Telegram messages
APP_URL=

# Optional: stronger model for the novelty check (more accurate, more expensive). Defaults to ANTHROPIC_MODEL.
ANTHROPIC_VERIFY_MODEL=
